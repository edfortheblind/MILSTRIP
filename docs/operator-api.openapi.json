          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "RECEIVED",
                    "PROCESSING",
                    "REQUIRES_REVIEW",
                    "VALID",
